{
  "name": "@alganet/phasm",
  "version": "0.1.3",
  "description": "PHP 8.5 compiled to WebAssembly",
  "main": "dist/php.js",
  "module": "dist/php.js",
  "types": "dist/php.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/php.d.ts",
      "import": "./dist/php.js",
      "default": "./dist/php.js"
    },
    "./builtin": {
      "types": "./dist/builtin.d.ts",
      "import": "./dist/builtin.mjs",
      "default": "./dist/builtin.mjs"
    },
    "./wasm": "./dist/php.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alganet/phasm.git"
  },
  "keywords": [
    "php",
    "wasm",
    "webassembly"
  ],
  "author": "Alexandre Gomes Gaigalas <alganet@gmail.com>",
  "license": "ISC"
}
