{
  "name": "@alganet/phasm",
  "version": "0.6.0",
  "description": "PHP 8.5 compiled to WebAssembly",
  "main": "dist/php.js",
  "module": "dist/php.js",
  "types": "dist/php.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/php.d.ts",
      "import": "./dist/php.js",
      "default": "./dist/php.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.mjs",
      "default": "./dist/mount.mjs"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.mjs",
      "default": "./dist/resolve.mjs"
    },
    "./wasm": "./dist/php.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alganet/phasm.git"
  },
  "keywords": [
    "php",
    "wasm",
    "webassembly"
  ],
  "author": "Alexandre Gomes Gaigalas <alganet@gmail.com>",
  "license": "ISC",
  "peerDependencies": {
    "@zenfs/core": ">=2.4.2",
    "@zenfs/emscripten": ">=1.0.7"
  },
  "peerDependenciesMeta": {
    "@zenfs/core": {
      "optional": true
    },
    "@zenfs/emscripten": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zenfs/core": "2.6.3",
    "@zenfs/emscripten": "1.0.7",
    "wasi-sh": "0.11.0"
  }
}
